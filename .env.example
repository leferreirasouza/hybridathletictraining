# Supabase project credentials
# Copy this file to .env and fill in your values.
# Never commit .env to git.

VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Google/Apple sign-in. Unset (Lovable Cloud): Lovable's managed OAuth broker.
# "supabase" (own Supabase project): plain Supabase Auth; configure the Google
# client and Apple Services ID in that project's Auth settings.
VITE_AUTH_MODE=""

# Edge Function secrets are NOT set here. Set them with `supabase secrets set`
# (or the dashboard), never in a chat. AI calls: GEMINI_API_KEY (own project)
# or LOVABLE_API_KEY (auto-provisioned on Lovable Cloud); see
# supabase/functions/_shared/aiClient.ts.
